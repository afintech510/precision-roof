# ─────────────────────────────────────────────────────────────────────────────
# precision-roof — environment template. Real values live in Doppler (dev config)
# and Cloudflare secrets; never commit a filled-in .env. Grouped by build phase.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity (Phase 01 CMS) ────────────────────────────────────────────────────
SANITY_PROJECT_ID=af66eilq  # public identifier (also committed in sanity.config.ts)
SANITY_DATASET=production    # public
SANITY_API_TOKEN=            # SECRET → Doppler + Pages runtime (editor/deploy token)

# ── Cloudflare (Phases 00/02/05x) — NEEDED NOW to create D1 + deploy ─────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=        # scopes: D1 edit, Workers/Pages edit
D1_DATABASE_ID=             # from `wrangler d1 create precision-roof-op`

# ── Cloudflare Turnstile (Phases 05b/05d) — free Standard tier ───────────────
TURNSTILE_SITE_KEY=0x4AAAAAAEEvXcuej7pxytgO  # public (embedded in HTML)
TURNSTILE_SECRET_KEY=                         # SECRET → Doppler + Pages runtime

# ── GA4 Measurement Protocol (Phases 05a/05b) ────────────────────────────────
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ── Cal.com (Phase 05a) ──────────────────────────────────────────────────────
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# ── Twilio (Phase 05b) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=   # or a NANP number below
TWILIO_PHONE_NUMBER=
# A2P 10DLC brand/campaign registration is a Phase-0 gate (spec §5.2).

# ── CallRail DNI (Phase 05c) ─────────────────────────────────────────────────
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=
CALLRAIL_WEBHOOK_SECRET=      # SECRET → Doppler + Pages runtime (post-call webhook signing)
# ANI-passthrough verification is a Phase-0 gate (spec §5.3). Not confirmed in
# this environment — missed-call text-back is driven from CallRail's own
# post-call webhook payload (the spec's documented fallback), not a Twilio
# inbound leg, so it doesn't block on this gate.

# ── Financing — Acorn OR Wisetack (Phase 05c) ────────────────────────────────
FINANCING_PARTNER=          # "acorn" | "wisetack"
FINANCING_API_KEY=
FINANCING_PARTNER_ID=

# ── Email — Postmark or SES (Phase 09) ───────────────────────────────────────
POSTMARK_SERVER_TOKEN=
# or AWS SES:
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=

# ── Operator dashboard auth — Cloudflare Access / OIDC (Phase 05e) ────────────
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ── Google Business Profile API (Phase 06/reviews) ───────────────────────────
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../lib/content';
import StructuredData from '../components/StructuredData.astro';
import { roofingContractor } from '../lib/structured-data';
import type { SiteSettings } from '../lib/types';

interface Props { title: string; description?: string; schema?: unknown[] }
const { title, description = 'Transparent, town-by-town roofing across Suffolk County, NY. Licensed, insured, itemized pricing.', schema = [] } = Astro.props;
const site: SiteSettings = await getSite();
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://premiumroofsolutions.com').href;
const jsonLd = [roofingContractor(site), ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#143b5e" />
    <StructuredData schema={jsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header site={site} />
    <main id="main">
      <slot />
    </main>
    <Footer site={site} />

    <a class="mobile-call btn btn-emergency" href={site.phoneHref} aria-label={`Call ${site.phone}`}>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012 4.2 2 2 0 014 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8 9.6a16 16 0 006 6l1.2-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
      Call now
    </a>

    <style>
      .mobile-call { position: fixed; right: 16px; bottom: 16px; z-index: 50; box-shadow: var(--shadow-lg); }
      @media (min-width: 1000px) { .mobile-call { display: none; } }
    </style>
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinancingFacade from '../components/FinancingFacade.astro';
import { getSite } from '../lib/content';
const site = await getSite();
---
<BaseLayout title={`Roof Financing — ${site.businessName}`} description="Optional third-party roof financing with a soft-pull prequal that won't affect your credit score.">
  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">Financing</span>
      <h1>Flexible options for a bigger project</h1>
      <p class="lede">Need to spread out a full replacement? We partner with a third-party lender offering a soft-pull prequalification — checking your options won’t affect your credit score.</p>
      <FinancingFacade financingLink={site.financingLink} phone={site.phone} phoneHref={site.phoneHref} />
      <p class="disc muted">All financing terms are set by the third-party lender. We make no guarantee of approval, rate, or term. Financing language complies with NY GBL §771-B.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .narrow { max-width: 720px; }
  h1 { margin: 12px 0 14px; }
  .disc { font-size: .84rem; margin-top: 18px; }
</style>

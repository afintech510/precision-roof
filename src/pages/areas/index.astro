---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTowns, getTownNames } from '../../lib/content';
const towns = await getTowns();
const townNames = await getTownNames();
const detailed = new Map(towns.map((t) => [t.slug, t]));
---
<BaseLayout title="Service Areas — Suffolk County Roofing" description="12 deeply researched Suffolk County towns — building departments, permits, historic districts and pricing.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Service areas</span>
      <h2>12 Suffolk towns, researched to the block</h2>
      <p class="lede">Western and central Suffolk publish first. Each town page carries real building-department details, permit timelines, and pricing — never a name-swapped template.</p>
      <div class="grid grid-2 grid-3 tgrid">
        {townNames.map((name) => {
          const slug = name.toLowerCase().replace(/\s+/g, '-');
          const t = detailed.get(slug);
          return t
            ? <a class="tcard card linked" href={`/areas/${slug}/`}><h3>{name} <span aria-hidden="true">→</span></h3><p class="muted">{t.blurb.slice(0, 96)}…</p></a>
            : <div class="tcard card"><h3>{name}</h3><p class="muted">Deep-dive page publishing soon.</p></div>;
        })}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .tgrid { margin-top: 26px; }
  .tcard h3 { margin-bottom: 6px; }
  .tcard p { font-size: .92rem; }
  .tcard.linked:hover { border-color: var(--brand); box-shadow: var(--shadow-lg); transform: translateY(-2px); transition: .12s; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServices, getSite, getTownNames } from '../../lib/content';
import { breadcrumbs, serviceSchema } from '../../lib/structured-data';
import type { ServiceLite } from '../../lib/types';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
interface Props { service: ServiceLite }
const { service } = Astro.props;
const site = await getSite();
const townNames = (await getTownNames()).slice(0, 8);
const urgent = service.isEmergencyCluster;
const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: service.name, path: `/services/${service.slug}/` },
  ]),
  serviceSchema(service, site),
];
---
<BaseLayout title={`${service.name} in Suffolk County — ${site.businessName}`} description={service.summary} schema={schema}>
  <section class={`shero ${urgent ? 'urgent' : ''}`}>
    <div class="container shero-in">
      <span class="eyebrow">{urgent ? 'Emergency service' : 'Roofing service'}</span>
      <h1>{service.name} across Suffolk County</h1>
      <p class="lede">{service.summary}</p>
      <div class="hero-cta">
        {urgent
          ? <a class="btn btn-emergency" href={site.phoneHref}>Call {site.phone}</a>
          : <a class="btn btn-primary" href="/contact/">Book a free inspection</a>}
        <a class="btn btn-ghost" href="/contact/">Get itemized pricing</a>
      </div>
      <p class="lic tnum">✓ {site.licenseNumber} · Fully insured · Free inspections</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Honest work, documented</h2>
      <ul class="points">
        <li><strong>Written, itemized pricing.</strong> You see the line items before any work — what we quote is what you pay.</li>
        <li><strong>Photo-backed findings.</strong> We show you the actual problem, not a sales story.</li>
        <li><strong>Licensed &amp; insured.</strong> {site.licenseNumber}, verifiable with Suffolk County.</li>
        {urgent && <li><strong>Fast, honest response.</strong> We book an inspection quickly and tarp to stop damage — no time-bound promise we can’t keep.</li>}
      </ul>

      <div class="areas">
        <h3>Available in your town</h3>
        <div class="towns">
          {townNames.map((n) => {
            const slug = n.toLowerCase().replace(/\s+/g, '-');
            return <a href={`/areas/${slug}/`} class="town linked">{n}</a>;
          })}
          <a href="/areas/" class="town linked">All 12 towns →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container cta">
      <h2>{urgent ? `Roof emergency? Call now.` : `Get itemized pricing for ${service.name.toLowerCase()}`}</h2>
      <div class="cta-btns">
        <a class="btn btn-primary" href="/contact/">Book a free inspection</a>
        <a class="btn btn-onink tnum" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .shero { background: radial-gradient(120% 120% at 80% -20%, #eaf1f7, #fff 60%); border-bottom: 1px solid var(--line); }
  .shero.urgent { background: linear-gradient(180deg, #fdeff0, #fff 70%); }
  .shero-in { padding-block: clamp(38px, 5vw, 70px); max-width: 780px; }
  .shero h1 { margin: 12px 0 14px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 14px; }
  .lic { color: var(--good); font-weight: 700; font-size: .9rem; }
  .narrow { max-width: 780px; }
  .points { list-style: none; padding: 0; margin: 18px 0 30px; display: grid; gap: 14px; }
  .points li { padding-left: 30px; position: relative; }
  .points li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--good); font-weight: 800; }
  .areas h3 { margin-bottom: 12px; }
  .towns { display: flex; flex-wrap: wrap; gap: 10px; }
  .town { padding: 10px 15px; border-radius: 999px; background: #fff; border: 1px solid #cfdae4; font-weight: 600; font-size: .93rem; color: var(--brand); }
  .town.linked:hover { background: var(--brand); color: #fff; }
  .cta { text-align: center; display: grid; gap: 18px; place-items: center; }
  .cta-btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>

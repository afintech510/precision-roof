---
// SPEC-AMBIGUITY: exact warranty term lengths (workmanship years, which
// manufacturer lines are installed) aren't in the spec/SOW and need Adam's
// input before they can be published as specific claims — publishing a wrong
// figure here is a real liability, not just a copy nit. This page states the
// structure (two separate warranties, both in writing) without inventing
// numbers; the itemized quote is where a job's actual terms are documented.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/content';
const site = await getSite();
---
<BaseLayout title={`Warranties — ${site.businessName}`} description="What's covered on your new roof: a manufacturer material warranty and our own workmanship warranty, both provided in writing.">
  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">Warranties</span>
      <h1>Two warranties, both in writing</h1>
      <p class="lede">A new roof carries two separate kinds of coverage. We explain both up front, and the specific terms for your job are itemized in your written quote — not buried in fine print after the sale.</p>

      <div class="wcards">
        <div class="wcard card">
          <h3>Manufacturer material warranty</h3>
          <p>Covers defects in the shingles or roofing system itself. Coverage length and terms vary by manufacturer and product line — we tell you exactly which one applies before you sign anything.</p>
        </div>
        <div class="wcard card">
          <h3>Our workmanship warranty</h3>
          <p>Covers the installation itself — the work our crew does on your roof. Term length is confirmed in writing as part of your itemized quote, the same way every price we give is itemized rather than estimated.</p>
        </div>
      </div>

      <ul class="points">
        <li><strong>Nothing verbal.</strong> Warranty terms are written into your quote, not promised on a phone call.</li>
        <li><strong>Registered where required.</strong> If a manufacturer warranty requires registration, we handle it.</li>
        <li><strong>Licensed &amp; insured.</strong> {site.licenseNumber}, verifiable with Suffolk County.</li>
      </ul>

      <a class="btn btn-primary" href="/contact/">Ask about warranty coverage for your roof</a>
    </div>
  </section>
</BaseLayout>
<style>
  .narrow { max-width: 760px; }
  h1 { margin: 12px 0 14px; }
  .wcards { display: grid; gap: 16px; margin: 24px 0; }
  .wcard h3 { margin-bottom: 8px; }
  .points { list-style: none; padding: 0; margin: 8px 0 26px; display: grid; gap: 12px; }
  .points li { padding-left: 28px; position: relative; }
  .points li::before { content: "✓"; position: absolute; left: 0; color: var(--good); font-weight: 800; }
  @media (min-width: 640px) { .wcards { grid-template-columns: 1fr 1fr; } }
</style>

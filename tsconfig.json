{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "types": ["node", "astro/client", "vitest/globals", "@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "e2e", "sanity", "*.config.ts", "*.config.mjs"],
  "exclude": ["node_modules", "dist", ".astro"]
}
